            task_type="CHAT",
            selected_model="groq/openai/gpt-oss-20b",
            provider="groq",
            reason="Primary",
            confidence=0.9,
            candidate_count=1,
            free_candidate_count=1,
            factors={},
            evaluated_candidates=[],
            rejected_candidates=[],
            is_manual_override=False,
            fallback_used=True,
            router_enabled=True,
        )

        error_413 = OmniRouteAPIError("Limit 8000 exceeded", status_code=413)

        with patch("app.send_chat") as mock_send, \
             patch("core.router.get_retry_model") as mock_retry:

            app._handle_api_failure(
                error=error_413,
                chat=chat,
                target_model="groq/openai/gpt-oss-20b",
                messages=messages,
                full_messages=messages,
                decision=decision,
                streaming=False,
                fallback_used=True,
                is_retry=True,
                attempted_models={"groq/openai/gpt-oss-20b", "aihorde/other"},
                fallback_attempts=2,  # Already at max_fallbacks
                t_start=time.time(),
            )

            mock_send.assert_not_called()
            mock_retry.assert_not_called()

    # --------------------------------------------------------------
    # 8. Retry-After Wait Handling
    # --------------------------------------------------------------

    def test_13_short_retry_after_waits_and_reduces_context(self):
        """When retry-after is short (<= 5s) and context can be reduced, waits and retries."""
        import app
        from api.omniroute import OmniRouteAPIError

        chat = {"id": "test-chat", "title": "Test Chat", "messages": []}
        # Multi-turn messages that can be pruned
        full_messages = [
            {"role": "system", "content": "sys prompt"},
            {"role": "user", "content": "old question " + ("x" * 2000)},
            {"role": "assistant", "content": "old answer " + ("y" * 2000)},
            {"role": "user", "content": "latest question"},
        ]
        # Current payload that was sent unpruned
        current_messages = list(full_messages)

        error_429 = OmniRouteAPIError(
            "Rate limited. Limit 8000, Requested 9000. Try again in 2s.",
            status_code=429,
            retry_after=2.0,
            detected_tpm_limit=8000,
        )

        with patch("core.router.get_retry_model", return_value=None), \
             patch("app.time.sleep") as mock_sleep, \
             patch("app.send_chat") as mock_send:

            mock_send.return_value = {
                "answer": "Success after wait",
                "actual_model": "groq/openai/gpt-oss-20b",
                "prompt_tokens": 100,
                "completion_tokens": 10,
                "total_tokens": 110,
                "response_time": 0.2,
            }

            app._handle_api_failure(
                error=error_429,
                chat=chat,
                target_model="groq/openai/gpt-oss-20b",
                messages=current_messages,
                full_messages=full_messages,
                decision=None,
                streaming=False,
                fallback_used=False,
                is_retry=False,
                attempted_models={"groq/openai/gpt-oss-20b"},
                fallback_attempts=0,
                t_start=time.time(),
            )

            # Must have slept for 2.0 seconds
            mock_sleep.assert_called_once_with(2.0)
            mock_send.assert_called_once()


