    # --------------------------------------------------------------

    def test_12_fallback_stops_after_max_attempts(self):
        """When fallback_attempts reaches max_fallbacks, no further dispatch is made."""
        import app
        from api.omniroute import OmniRouteAPIError
        from core.router import RoutingDecision

        chat = {"id": "test-chat", "title": "Test Chat", "messages": []}
        messages = [{"role": "user", "content": "hello"}]
